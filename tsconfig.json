{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],

    /* The brief requires both of these. noUncheckedIndexedAccess is the important one
       here: this codebase indexes into arrays of parsed spreadsheet rows constantly, and
       a real Tally export is exactly where an off-by-one produces `undefined` at runtime
       rather than at review time. */
    "strict": true,
    "noUncheckedIndexedAccess": true,

    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    /* Vite emits the bundle; tsc is used purely as a type checker (`npm run build`
       runs `tsc --noEmit` before `vite build`). */
    "noEmit": true
  },
  "include": ["src", "scripts", "vite.config.ts", "vitest.config.ts"],
  "exclude": ["src/fixtures/sample"]
}
